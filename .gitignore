# ==============================
# AI Resume Analyzer — .gitignore
# ==============================

# --- Node / React (client + server) ---
node_modules/
dist/
build/
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Uploaded files (server) ---
server/uploads/*
!server/uploads/.gitkeep

# --- Python / FastAPI (ml-service) ---
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
ml-service/models/*
!ml-service/models/.gitkeep

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
