# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Ne JAMAIS commiter le fichier ".env" réel.

PORT=5000
NODE_ENV=development

# MongoDB (sera utilisé à partir de la Phase 3)
MONGO_URI=mongodb://localhost:27017/ai-resume-analyzer

# JWT (sera utilisé à partir de la Phase 4)
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# Service ML Python (sera utilisé à partir de la Phase 8-9)
ML_SERVICE_URL=http://localhost:8000

# AI API / GenAI (sera utilisé à partir de la Phase 11)
AI_API_KEY=your_api_key_here
